# Un único proyecto para desarrollar, probar y presentar.
# El asistente copia los mismos valores a TEST_* y PRESENTATION_* por compatibilidad.
# URL y clave publicable: viajan en la APK y NO conceden privilegios.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
# Alias de la MISMA conexión, no otro proyecto:
PRESENTATION_SUPABASE_URL=
PRESENTATION_SUPABASE_PUBLISHABLE_KEY=
# Credenciales de una cuenta verificada en la base compartida.
# Solo para ejecutar el contrato desde tu ordenador; nunca en Gradle/APK/CI público.
TEST_TEST_EMAIL=
TEST_TEST_PASSWORD=
# Alias de la MISMA cuenta:
PRESENTATION_TEST_EMAIL=
PRESENTATION_TEST_PASSWORD=
