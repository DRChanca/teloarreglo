<?xml version="1.0" encoding="utf-8"?>
<!-- The flash grows where the third peck lands. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:duration="1000">
        <propertyValuesHolder android:propertyName="scaleX">
            <keyframe android:fraction="0" android:value="0" />
            <keyframe android:fraction="0.54" android:value="0" />
            <keyframe android:fraction="0.70" android:value="1.3" android:interpolator="@android:interpolator/decelerate_quad" />
            <keyframe android:fraction="0.82" android:value="1" />
            <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator android:duration="1000">
        <propertyValuesHolder android:propertyName="scaleY">
            <keyframe android:fraction="0" android:value="0" />
            <keyframe android:fraction="0.54" android:value="0" />
            <keyframe android:fraction="0.70" android:value="1.3" android:interpolator="@android:interpolator/decelerate_quad" />
            <keyframe android:fraction="0.82" android:value="1" />
            <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
