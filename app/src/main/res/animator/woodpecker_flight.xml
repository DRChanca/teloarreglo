<?xml version="1.0" encoding="utf-8"?>
<!-- The bird flies in to the trunk, decelerating, and stays there (first 45 %). -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android" android:duration="@integer/splash_animation_millis">
    <propertyValuesHolder android:propertyName="translateX">
        <keyframe android:fraction="0" android:value="-50" />
        <keyframe android:fraction="0.45" android:value="0" android:interpolator="@android:interpolator/decelerate_cubic" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="translateY">
        <keyframe android:fraction="0" android:value="-10" />
        <keyframe android:fraction="0.45" android:value="0" android:interpolator="@android:interpolator/decelerate_quad" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
