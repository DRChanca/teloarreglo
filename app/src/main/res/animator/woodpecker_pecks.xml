<?xml version="1.0" encoding="utf-8"?>
<!-- Head back while flying; after landing, two pecks (fast hit, slower recoil) of 20 % each, then rest. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android" android:duration="@integer/splash_animation_millis">
    <propertyValuesHolder android:propertyName="rotation">
        <keyframe android:fraction="0" android:value="-25" />
        <keyframe android:fraction="0.50" android:value="-25" />
        <keyframe android:fraction="0.57" android:value="0" android:interpolator="@android:interpolator/accelerate_quad" />
        <keyframe android:fraction="0.70" android:value="-25" android:interpolator="@android:interpolator/decelerate_quad" />
        <keyframe android:fraction="0.77" android:value="0" android:interpolator="@android:interpolator/accelerate_quad" />
        <keyframe android:fraction="0.90" android:value="-25" android:interpolator="@android:interpolator/decelerate_quad" />
        <keyframe android:fraction="1" android:value="-25" />
    </propertyValuesHolder>
</objectAnimator>
