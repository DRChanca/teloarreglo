<?xml version="1.0" encoding="utf-8"?>
<!-- Three pecks (fast hit, slower recoil); the head ends back in its resting position. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android" android:duration="1000">
    <propertyValuesHolder android:propertyName="rotation">
        <keyframe android:fraction="0" android:value="-25" />
        <keyframe android:fraction="0.10" android:value="0" android:interpolator="@android:interpolator/accelerate_quad" />
        <keyframe android:fraction="0.22" android:value="-25" android:interpolator="@android:interpolator/decelerate_quad" />
        <keyframe android:fraction="0.32" android:value="0" android:interpolator="@android:interpolator/accelerate_quad" />
        <keyframe android:fraction="0.44" android:value="-25" android:interpolator="@android:interpolator/decelerate_quad" />
        <keyframe android:fraction="0.54" android:value="0" android:interpolator="@android:interpolator/accelerate_quad" />
        <keyframe android:fraction="0.72" android:value="-25" android:interpolator="@android:interpolator/decelerate_quad" />
        <keyframe android:fraction="1" android:value="-25" />
    </propertyValuesHolder>
</objectAnimator>
