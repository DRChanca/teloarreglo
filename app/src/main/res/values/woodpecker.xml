<resources>
    <!--
    Teloarreglo woodpecker (#58), on a 108x108 viewport whose inner circle of radius 33 is what the
    splash and adaptive-icon masks always show. Shared by the splash, the launcher icon and its
    monochrome layer. The head and beak are separate paths so they can peck; the eye is a hole in the head (evenOdd).
    The trunk runs past the visible circle so the mask cuts its ends in arcs.
    -->
    <string name="woodpecker_trunk_path" translatable="false">M60,14 L72,14 L72,94 L60,94 Z</string>
    <string name="woodpecker_body_path" translatable="false">M47,40 C53,40 59,46 59,56 L59,68 C57,72 53,72 51,70 C44,64 41,52 44,45 C45,42 46,41 47,40 Z M53,67 L59.5,84 L56.5,85 L49,70 Z M56,62 L61.5,61 L61.5,62.8 L56,64 Z M56,67 L61.5,66.5 L61.5,68.3 L56,69 Z</string>
    <string name="woodpecker_head_path" translatable="false">M45,38 A7,7 0 1,0 59,38 A7,7 0 1,0 45,38 Z M53,36.6 A1.2,1.2 0 1,0 55.4,36.6 A1.2,1.2 0 1,0 53,36.6 Z</string>
    <string name="woodpecker_beak_path" translatable="false">M57,35.6 L62.5,38 L57,40.4 Z</string>
    <string name="woodpecker_crest_path" translatable="false">M42.5,32 L46,34 C47,31.4 49.6,30.4 52.4,30.6 C54.4,30.8 55.8,31.6 56.6,32.4 C53,32.4 49.6,34.4 48.2,37.8 C47.2,37.2 46.2,36.2 45.6,35.2 Z</string>
    <!-- Splash only: the wing, folded inside the body (invisible at rest), raised while flying in. -->
    <string name="woodpecker_wing_path" translatable="false">M48,46 C45,52 46,60 51,66 C54,62 55,54 52,47 Z</string>
    <!--
    Splash only: the trunk as the splash icon shows it, cut by the icon mask (centre 54,54, radius 36), so
    the app's woodpecker drawable takes over from the system icon without a visible change.
    -->
    <string name="woodpecker_splash_trunk_path" translatable="false">M60,18.504 A36,36 0 0,1 72,22.823 L72,85.177 A36,36 0 0,1 60,89.496 Z</string>
    <!--
    Splash timing (#57), the one source for the animators and StartSplash: the woodpecker animation lasts
    splash_animation_millis (the animators' keyframes are fractions of it: flight to 41 %, three pecks,
    rest), then the splash leaves in splash_exit_millis. On a very fast start the flight waits until
    splash_lead_in_millis after the activity is created, so the system launch transition cannot hide it.
    -->
    <integer name="splash_animation_millis">1100</integer>
    <integer name="splash_lead_in_millis">400</integer>
    <integer name="splash_exit_millis">300</integer>
    <!-- Splash colors (light); values-night has the dark ones. -->
    <color name="woodpecker_body">#1C1B1F</color>
    <color name="woodpecker_crest">#C62828</color>
    <color name="woodpecker_trunk">#8D6E63</color>
    <!-- Launcher icon: always the light colors on the light background, whatever the launcher's mode. -->
    <color name="ic_launcher_background">#F7F8F5</color>
</resources>
